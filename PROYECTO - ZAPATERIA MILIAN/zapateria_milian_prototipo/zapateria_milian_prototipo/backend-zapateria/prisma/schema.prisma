model tbl_ventas {
  id_venta          BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  id_cliente        Int                  @db.UnsignedInt
  id_pedido         BigInt?              @unique(map: "uq_ventas_pedido") @db.UnsignedBigInt
  id_usuario        Int                  @db.UnsignedInt
  fecha_venta       DateTime             @default(now()) @db.DateTime(0)
  tipo_pago         tbl_ventas_tipo_pago
  total_venta       Decimal              @default(0.00) @db.Decimal(14, 2)
  monto_pagado      Decimal              @default(0.00) @db.Decimal(14, 2)
  saldo_credito     Decimal              @default(0.00) @db.Decimal(14, 2)
  observaciones     String?              @db.VarChar(500)
  estado            tbl_ventas_estado    @default(BORRADOR)
  tbl_creditos      tbl_creditos?
  tbl_detalle_venta tbl_detalle_venta[]
  tbl_clientes      tbl_clientes         @relation(fields: [id_cliente], references: [id_cliente], map: "fk_ventas_clientes")
  tbl_pedidos       tbl_pedidos?         @relation(fields: [id_pedido], references: [id_pedido], onDelete: Restrict, map: "fk_ventas_pedidos")
  tbl_usuarios      tbl_usuarios         @relation(fields: [id_usuario], references: [id_usuario], map: "fk_ventas_usuarios")

  @@index([id_cliente], map: "fk_ventas_clientes")
  @@index([id_usuario], map: "fk_ventas_usuarios")
}

