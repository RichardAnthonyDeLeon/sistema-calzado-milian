  monto              Decimal             @db.Decimal(14, 2)
  observaciones      String?             @db.VarChar(500)
  tbl_creditos       tbl_creditos        @relation(fields: [id_credito], references: [id_credito], map: "fk_abonos_creditos")
  tbl_cuotas_credito tbl_cuotas_credito? @relation(fields: [id_cuota], references: [id_cuota], onDelete: Restrict, map: "fk_abonos_cuotas")
  tbl_usuarios       tbl_usuarios        @relation(fields: [id_usuario], references: [id_usuario], map: "fk_abonos_usuarios")

  @@index([id_credito], map: "fk_abonos_creditos")
  @@index([id_cuota], map: "fk_abonos_cuotas")
  @@index([id_usuario], map: "fk_abonos_usuarios")
}

